<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Plantilla de Correo de Recordatorio Preventivo -->
        <record id="email_template_recordatorio_mantenimiento" model="mail.template">
            <field name="name">Recordatorio Mantenimiento Preventivo</field>
            <field name="model_id" ref="taller_mecanico.model_taller_vehiculo"/>
            <field name="subject">Recordatorio: Mantenimiento Preventivo para tu Vehículo {{ object.placa }}</field>
            <field name="partner_to">{{ object.propietario_id.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Inter', Helvetica, Arial, sans-serif; font-size: 14px; background-color: #F8FAFC;">
                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F8FAFC; padding: 32px 0px;">
                        <tbody>
                            <tr>
                                <td align="center">
                                    <table border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
                                        <tbody>
                                            <!-- Header -->
                                            <tr>
                                                <td align="center" style="background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%); padding: 40px 20px; color: #ffffff;">
                                                    <h1 style="margin: 0px; font-size: 24px; font-weight: 700; letter-spacing: -0.5px;">Recordatorio de Mantenimiento</h1>
                                                    <p style="margin: 8px 0px 0px 0px; font-size: 14px; opacity: 0.85;">Cuidamos el rendimiento de tu vehículo</p>
                                                </td>
                                            </tr>
                                            <!-- Body -->
                                            <tr>
                                                <td style="padding: 40px 32px; color: #334155; line-height: 1.6;">
                                                    <p style="margin: 0px 0px 16px 0px; font-size: 16px; font-weight: 600; color: #0F172A;">
                                                        Hola <t t-out="object.propietario_id.name"/>,
                                                    </p>
                                                    <p style="margin: 0px 0px 24px 0px;">
                                                        Esperamos que te encuentres muy bien. De acuerdo con nuestros registros, ha transcurrido el tiempo sugerido o el kilometraje estimado para el próximo mantenimiento preventivo de tu vehículo:
                                                    </p>
                                                    
                                                    <!-- Info de Vehículo -->
                                                    <div style="background-color: #F1F5F9; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
                                                        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size: 14px; color: #475569;">
                                                            <tbody>
                                                                <tr>
                                                                    <td style="padding: 4px 0px; font-weight: 600; color: #0F172A; width: 120px;">Vehículo:</td>
                                                                    <td style="padding: 4px 0px;"><t t-out="object.marca_id.name"/> <t t-out="object.modelo_id.name"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="padding: 4px 0px; font-weight: 600; color: #0F172A;">Placa:</td>
                                                                    <td style="padding: 4px 0px;"><t t-out="object.placa"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="padding: 4px 0px; font-weight: 600; color: #0F172A;">Kilometraje:</td>
                                                                    <td style="padding: 4px 0px;"><t t-out="object.kilometraje"/> km</td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <p style="margin: 0px 0px 32px 0px;">
                                                        Realizar los mantenimientos preventivos a tiempo garantiza la seguridad de tu familia, extiende la vida útil de tu auto y previene costosas reparaciones a futuro.
                                                    </p>

                                                    <!-- Botón CTA -->
                                                    <div align="center" style="margin-bottom: 16px;">
                                                        <a href="/taller/cita" style="display: inline-block; background-color: #2563EB; color: #ffffff; font-weight: 700; text-decoration: none; padding: 14px 32px; border-radius: 50px; box-shadow: 0 4px 12px rgba(37,99,235,0.25); font-size: 15px;">
                                                            Agendar Cita de Mantenimiento
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                            <!-- Footer -->
                                            <tr>
                                                <td align="center" style="background-color: #F8FAFC; padding: 24px; border-top: 1px solid #E2E8F0; color: #94A3B8; font-size: 12px;">
                                                    <p style="margin: 0px 0px 4px 0px;">Autologic Taller Automotriz</p>
                                                    <p style="margin: 0px;">Este correo electrónico fue generado automáticamente. Por favor no respondas a este mensaje.</p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>
    </data>

    <!-- Tarea Automatizada (Cron) de Recordatorio de Mantenimiento -->
    <record id="ir_cron_send_preventive_reminders" model="ir.cron">
        <field name="name">Taller: Enviar Recordatorios Preventivos Diarios</field>
        <field name="model_id" ref="taller_mecanico.model_taller_vehiculo"/>
        <field name="state">code</field>
        <field name="code">model.action_cron_send_preventive_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(datetime.now().replace(hour=0, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
