<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taller_orden_tree" model="ir.ui.view">
        <field name="name">taller.orden.trabajo.tree</field>
        <field name="model">taller.orden.trabajo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehiculo_id"/>
                <field name="fecha_ingreso"/>
                <field name="tecnico_id"/>
                <field name="prioridad" widget="badge" decoration-danger="prioridad == 'urgente'" decoration-warning="prioridad == 'mantenimiento'" decoration-info="prioridad == 'rutinario'"/>
                <field name="costo_total_general" sum="Total"/>
                <field name="estado" widget="badge" decoration-success="estado == 'entregado'" decoration-info="estado in ('proceso', 'listo')"/>
            </list>
        </field>
    </record>

    <record id="view_taller_orden_kanban" model="ir.ui.view">
        <field name="name">taller.orden.trabajo.kanban</field>
        <field name="model">taller.orden.trabajo</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" class="o_kanban_small_column">
                <field name="name"/>
                <field name="vehiculo_id"/>
                <field name="tecnico_id"/>
                <field name="estado"/>
                <field name="prioridad"/>
                <field name="costo_total_general"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{record.prioridad.raw_value == 'urgente' ? 'oe_kanban_color_2' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <field name="prioridad" widget="label_selection" options="{'classes': {'urgente': 'danger', 'mantenimiento': 'warning', 'rutinario': 'info'}}"/>
                                    </div>
                                </div>
                                <div class="text-muted o_row">
                                    <field name="vehiculo_id"/>
                                </div>
                                <div class="text-muted o_row" t-if="record.tecnico_id.raw_value">
                                    <i class="fa fa-user-circle"/> <field name="tecnico_id"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <strong>Total: </strong><field name="costo_total_general" widget="monetary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_taller_orden_form" model="ir.ui.view">
        <field name="name">taller.orden.trabajo.form</field>
        <field name="model">taller.orden.trabajo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_enviar_propuesta" string="✉️ Enviar Propuesta al Cliente" type="object" 
                            class="oe_highlight" invisible="estado not in ('recibido', 'cotizacion_devuelta')"/>
                    <button name="action_aprobar_propuesta" string="✅ Aprobar (Forzar)" type="object" 
                            class="btn-secondary" invisible="estado not in ('cotizacion_enviada', 'cotizacion_devuelta')"
                            groups="taller_mecanico.group_taller_manager"/>
                    <button name="action_listo" string="✓ Marcar como Listo" type="object" 
                            class="oe_highlight" invisible="estado != 'cotizacion_aprobada'"/>
                    <button name="action_facturar" string="💰 Generar Factura" type="object" 
                            class="btn-primary" invisible="estado != 'listo' or factura_id != False" 
                            groups="taller_mecanico.group_taller_manager"/>
                    <button name="action_entregado" string="🚗 Entregar Vehículo" type="object" 
                            class="oe_highlight" invisible="estado != 'listo'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="recibido,cotizacion_enviada,cotizacion_aprobada,listo,entregado"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_factura" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not factura_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ver Factura</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Urgente" bg_color="bg-danger" invisible="prioridad != 'urgente'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehiculo_id"/>
                            <field name="cita_id"/>
                            <field name="prioridad"/>
                            <field name="fecha_ingreso"/>
                            <field name="kilometraje" string="Kilometraje de Ingreso"/>
                        </group>
                        <group>
                            <field name="tecnico_id"/>
                            <field name="tecnico_cargo"/>
                            <field name="costo_mano_obra" widget="monetary"/>
                            <field name="proximo_kilometraje_mto" string="Próximo Mantenimiento (km)"/>
                            <field name="proxima_fecha_mto" string="Próxima Fecha Mantenimiento"/>
                            <field name="factura_id" invisible="not factura_id"/>
                            <field name="factura_estado" invisible="not factura_id" widget="badge" 
                                   decoration-success="factura_estado == 'posted'" 
                                   decoration-info="factura_estado == 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recepción / Checklist">
                            <group>
                                <group string="Estado del Vehículo">
                                    <field name="nivel_gasolina" widget="radio" options="{'horizontal': true}"/>
                                    <field name="rayones_golpes" placeholder="Ej: Puerta del conductor abollada, parabrisas trizado..."/>
                                </group>
                                <group string="Inventario y Accesorios">
                                    <field name="llanta_repuesto"/>
                                    <field name="herramientas"/>
                                    <field name="gata"/>
                                    <field name="objetos_personales" placeholder="Ej: Gafas de sol en la guantera..."/>
                                </group>
                            </group>
                        </page>
                        <page string="Diagnóstico">
                            <field name="diagnostico" placeholder="Escriba el diagnóstico y observaciones..."/>
                        </page>
                        <page string="Peticiones del Cliente" invisible="not notas_cliente_propuesta">
                            <div class="alert alert-info" role="alert" invisible="not notas_cliente_propuesta">
                                <i class="fa fa-info-circle me-2"/> <strong>Nota:</strong> Estas son las observaciones enviadas por el cliente en la propuesta.
                            </div>
                            <field name="notas_cliente_propuesta" readonly="1"/>
                        </page>
                        <page string="Servicios Realizados">
                            <field name="servicio_linea_ids">
                                <list editable="bottom" decoration-info="agregado_por_cliente == True">
                                    <field name="producto_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="cantidad"/>
                                    <field name="precio_unitario" widget="monetary"/>
                                    <field name="is_extra" optional="hide"/>
                                    <field name="agregado_por_cliente" readonly="1" optional="show"/>
                                    <field name="state_extra"/>
                                    <field name="subtotal" widget="monetary" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Repuestos Utilizados">
                            <field name="repuesto_linea_ids">
                                <list editable="bottom" decoration-info="agregado_por_cliente == True">
                                    <field name="producto_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="cantidad"/>
                                    <field name="precio_unitario" widget="monetary"/>
                                    <field name="is_extra" optional="hide"/>
                                    <field name="agregado_por_cliente" readonly="1" optional="show"/>
                                    <field name="state_extra"/>
                                    <field name="subtotal" widget="monetary" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Historial de Propuestas">
                            <field name="propuesta_ids" readonly="1">
                                <list>
                                    <field name="fecha"/>
                                    <field name="creador_tipo"/>
                                    <field name="creador_nombre"/>
                                    <field name="notas"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right" colspan="2" name="orden_total">
                        <field name="costo_total_servicios" widget="monetary"/>
                        <field name="costo_total_repuestos" widget="monetary"/>
                        <field name="costo_mano_obra" widget="monetary"/>
                        <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                            <label for="costo_total_general"/>
                        </div>
                        <field name="costo_total_general" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_taller_orden" model="ir.actions.act_window">
        <field name="name">Órdenes de Trabajo</field>
        <field name="res_model">taller.orden.trabajo</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_taller_mis_ordenes" model="ir.actions.act_window">
        <field name="name">Mis Órdenes de Trabajo</field>
        <field name="res_model">taller.orden.trabajo</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('tecnico_id.user_id', '=', uid)]</field>
    </record>

    <menuitem id="menu_orden_action" parent="menu_taller_operaciones" action="action_taller_orden" sequence="20" groups="taller_mecanico.group_taller_manager"/>
    <menuitem id="menu_mis_ordenes_action" parent="menu_taller_operaciones" action="action_taller_mis_ordenes" sequence="25"/>
    <record id="view_taller_propuesta_form" model="ir.ui.view">
        <field name="name">taller.propuesta.form</field>
        <field name="model">taller.propuesta</field>
        <field name="arch" type="xml">
            <form string="Propuesta de Trabajo">
                <sheet>
                    <group>
                        <group>
                            <field name="orden_id" readonly="1"/>
                            <field name="creador_nombre" readonly="1"/>
                            <field name="creador_tipo" readonly="1"/>
                        </group>
                        <group>
                            <field name="fecha" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notas / Observaciones">
                        <field name="notas" readonly="1" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Servicios Propuestos">
                            <field name="linea_servicio_ids" readonly="1">
                                <list>
                                    <field name="producto_id"/>
                                    <field name="cantidad"/>
                                    <field name="precio_unitario"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Repuestos Propuestos">
                            <field name="linea_repuesto_ids" readonly="1">
                                <list>
                                    <field name="producto_id"/>
                                    <field name="cantidad"/>
                                    <field name="precio_unitario"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
