<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="vehicle_history_page" name="Expediente del Vehículo">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty bg-light py-4">
                <div class="container">
                    <!-- Custom Styles -->
                    <style type="text/css">
                        .timeline-container {
                            position: relative;
                            padding-left: 2rem;
                            border-left: 3px solid rgba(37, 99, 235, 0.2);
                            margin-left: 1rem;
                        }
                        .timeline-item {
                            position: relative;
                        }
                        .timeline-badge {
                            position: absolute;
                            left: -2.85rem;
                            top: 0.25rem;
                            width: 38px;
                            height: 38px;
                            background-color: #2563EB;
                            color: white;
                            border-radius: 50%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            z-index: 10;
                            box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.15);
                            transition: all 0.3s ease;
                        }
                        .timeline-item:hover .timeline-badge {
                            transform: scale(1.1);
                            box-shadow: 0 0 0 8px rgba(37, 99, 235, 0.25);
                        }
                        .timeline-panel {
                            transition: transform 0.2s ease, box-shadow 0.2s ease;
                        }
                        .timeline-panel:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05) !important;
                        }
                        .bg-success-soft {
                            background-color: rgba(16, 185, 129, 0.1);
                            color: #10B981;
                        }
                        .bg-primary-soft {
                            background-color: rgba(37, 99, 235, 0.08);
                            color: #2563EB;
                        }
                    </style>

                    <!-- Header Card -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%); color: white;">
                        <div class="row align-items-center">
                            <div class="col-md-8 mb-3 mb-md-0 d-flex align-items-center">
                                <div class="bg-white bg-opacity-20 p-3 rounded-circle me-4 d-none d-sm-block">
                                    <i class="fa fa-car fa-2x"/>
                                </div>
                                <div>
                                    <h2 class="fw-bold mb-1">Expediente del Vehículo</h2>
                                    <p class="mb-0 opacity-75">
                                        Placa: <strong class="text-white"><t t-esc="vehicle.placa"/></strong> | 
                                        Marca: <t t-esc="vehicle.marca_id.name"/> | 
                                        Modelo: <t t-esc="vehicle.modelo_id.name"/>
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <a href="/taller/mi_cuenta" class="btn btn-light rounded-pill px-4 shadow-sm text-primary fw-bold">
                                    <i class="fa fa-arrow-left me-1"/> Mi Cuenta
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Pestañas de Navegación -->
                    <ul class="nav nav-pills nav-fill bg-white rounded-pill p-2 shadow-sm mb-4 border" id="vehicleTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active rounded-pill fw-bold" id="trabajos-tab" data-bs-toggle="tab" data-bs-target="#trabajos" type="button" role="tab" aria-controls="trabajos" aria-selected="true">
                                <i class="fa fa-wrench me-2"/> Historial de Trabajos
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill fw-bold" id="citas-tab" data-bs-toggle="tab" data-bs-target="#citas" type="button" role="tab" aria-controls="citas" aria-selected="false">
                                <i class="fa fa-calendar me-2"/> Citas Agendadas
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill fw-bold" id="facturas-tab" data-bs-toggle="tab" data-bs-target="#facturas" type="button" role="tab" aria-controls="facturas" aria-selected="false">
                                <i class="fa fa-file-pdf-o me-2"/> Facturas
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="vehicleTabsContent">

                        <!-- ========== TAB 1: TRABAJOS ========== -->
                        <div class="tab-pane fade show active" id="trabajos" role="tabpanel" aria-labelledby="trabajos-tab">
                            <t t-if="not ordenes">
                                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                                    <div class="mb-4 text-muted">
                                        <i class="fa fa-folder-open-o fa-4x opacity-50"/>
                                    </div>
                                    <h4 class="fw-bold text-dark mb-2">Sin Intervenciones Registradas</h4>
                                    <p class="text-muted mb-0">Este vehículo aún no cuenta con órdenes de trabajo en nuestro taller.</p>
                                </div>
                            </t>
                            <t t-if="ordenes">
                                <div class="row">
                                    <div class="col-lg-10 mx-auto">
                                        <div class="timeline-container">
                                            <t t-foreach="ordenes" t-as="orden">
                                                <div class="timeline-item mb-5">
                                                    <div class="timeline-badge">
                                                        <i class="fa fa-wrench"/>
                                                    </div>
                                                    <div class="timeline-panel card border-0 shadow-sm rounded-4 p-4 bg-white">
                                                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                                            <div>
                                                                <h4 class="fw-bold text-dark mb-0"><t t-esc="orden.name"/></h4>
                                                                <span class="badge bg-success-soft px-3 py-1 rounded-pill mt-2 d-inline-block small fw-bold">
                                                                    <i class="fa fa-calendar me-1"/>
                                                                    <t t-esc="orden.fecha_ingreso" t-options='{"widget": "date"}'/>
                                                                </span>
                                                                <span t-attf-class="badge px-3 py-1 rounded-pill mt-2 ms-1 d-inline-block small fw-bold #{'bg-success text-white' if orden.estado == 'entregado' else 'bg-warning text-dark' if orden.estado == 'listo' else 'bg-primary text-white'}">
                                                                    <t t-esc="(orden.estado or '').upper()"/>
                                                                </span>
                                                            </div>
                                                            <div class="text-md-end mt-2 mt-md-0">
                                                                <span class="badge bg-primary-soft px-3 py-2 rounded-pill fw-bold">
                                                                    <i class="fa fa-tachometer me-1"/>
                                                                    <t t-esc="orden.kilometraje"/> km
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div class="mb-4 p-3 rounded-3" style="background-color: #F8FAFC; border-left: 4px solid #3B82F6;">
                                                            <h6 class="fw-bold mb-2 text-dark"><i class="fa fa-stethoscope me-1 text-primary"/> Diagnóstico</h6>
                                                            <p class="mb-0 text-muted small"><t t-esc="orden.diagnostico or 'Sin observaciones'"/></p>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-6 mb-3">
                                                                <div class="p-3 border rounded-3 bg-white h-100">
                                                                    <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                                                                        <i class="fa fa-cog me-1 text-primary"/> Servicios
                                                                    </h6>
                                                                    <t t-if="not orden.servicio_linea_ids">
                                                                        <p class="text-muted small mb-0">No se registraron servicios.</p>
                                                                    </t>
                                                                    <t t-if="orden.servicio_linea_ids">
                                                                        <ul class="list-unstyled mb-0">
                                                                            <t t-foreach="orden.servicio_linea_ids" t-as="servicio">
                                                                                <li class="small text-muted py-2 d-flex justify-content-between align-items-center border-bottom border-light">
                                                                                    <span class="text-dark"><t t-esc="servicio.producto_id.name"/></span>
                                                                                    <span class="fw-bold text-secondary">
                                                                                        <t t-esc="servicio.cantidad"/> x $<t t-esc="servicio.precio_unitario"/>
                                                                                    </span>
                                                                                </li>
                                                                            </t>
                                                                        </ul>
                                                                    </t>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6 mb-3">
                                                                <div class="p-3 border rounded-3 bg-white h-100">
                                                                    <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                                                                        <i class="fa fa-cogs me-1 text-primary"/> Repuestos
                                                                    </h6>
                                                                    <t t-if="not orden.repuesto_linea_ids">
                                                                        <p class="text-muted small mb-0">No se utilizaron repuestos.</p>
                                                                    </t>
                                                                    <t t-if="orden.repuesto_linea_ids">
                                                                        <ul class="list-unstyled mb-0">
                                                                            <t t-foreach="orden.repuesto_linea_ids" t-as="repuesto">
                                                                                <li class="small text-muted py-2 d-flex justify-content-between align-items-center border-bottom border-light">
                                                                                    <span class="text-dark"><t t-esc="repuesto.producto_id.name"/></span>
                                                                                    <span class="fw-bold text-secondary">
                                                                                        <t t-esc="repuesto.cantidad"/> x $<t t-esc="repuesto.precio_unitario"/>
                                                                                    </span>
                                                                                </li>
                                                                            </t>
                                                                        </ul>
                                                                    </t>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- ========== TAB 2: CITAS ========== -->
                        <div class="tab-pane fade" id="citas" role="tabpanel" aria-labelledby="citas-tab">
                            <t t-if="not citas">
                                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                                    <div class="mb-4 text-muted">
                                        <i class="fa fa-calendar-times-o fa-4x opacity-50"/>
                                    </div>
                                    <h4 class="fw-bold text-dark mb-2">Sin Citas Registradas</h4>
                                    <p class="text-muted mb-0">No se encontraron citas pasadas o futuras para este vehículo.</p>
                                </div>
                            </t>
                            <t t-if="citas">
                                <div class="row g-4">
                                    <t t-foreach="citas" t-as="cita">
                                        <div class="col-md-6 col-lg-4">
                                            <div class="card border-0 shadow-sm rounded-4 h-100 border-top border-4 border-primary">
                                                <div class="card-body p-4">
                                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                                        <div>
                                                            <h6 class="fw-bold text-dark mb-1">
                                                                <i class="fa fa-calendar-check-o text-primary me-2"/>
                                                                <t t-esc="cita.fecha_cita" t-options='{"widget": "datetime"}'/>
                                                            </h6>
                                                        </div>
                                                        <span t-attf-class="badge rounded-pill #{'bg-success' if cita.estado == 'confirmada' else 'bg-danger' if cita.estado == 'cancelada' else 'bg-secondary'}">
                                                            <t t-esc="(cita.estado or 'N/A').upper()"/>
                                                        </span>
                                                    </div>
                                                    <p class="text-muted small mb-2"><strong>Motivo:</strong> <t t-esc="cita.motivo"/></p>
                                                    <t t-if="cita.descripcion">
                                                        <p class="text-muted small mb-2"><t t-esc="cita.descripcion"/></p>
                                                    </t>
                                                    <t t-if="cita.prioridad">
                                                        <span t-attf-class="badge rounded-pill me-1 #{'bg-danger' if cita.prioridad == 'urgente' else 'bg-info' if cita.prioridad == 'mantenimiento' else 'bg-light text-dark border'}">
                                                            <t t-esc="(cita.prioridad or '').capitalize()"/>
                                                        </span>
                                                    </t>
                                                    <t t-if="cita.tecnico_id">
                                                        <p class="text-muted small mb-0 mt-2"><i class="fa fa-user-circle text-primary me-1"/> Técnico: <t t-esc="cita.tecnico_id.name"/></p>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <!-- ========== TAB 3: FACTURAS ========== -->
                        <div class="tab-pane fade" id="facturas" role="tabpanel" aria-labelledby="facturas-tab">
                            <t t-if="not facturas">
                                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                                    <div class="mb-4 text-muted">
                                        <i class="fa fa-file-excel-o fa-4x opacity-50"/>
                                    </div>
                                    <h4 class="fw-bold text-dark mb-2">Sin Facturas</h4>
                                    <p class="text-muted mb-0">Este vehículo no tiene facturas emitidas por trabajos realizados.</p>
                                </div>
                            </t>
                            <t t-if="facturas">
                                <div class="table-responsive bg-white rounded-4 shadow-sm p-2">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="bg-light text-muted small text-uppercase">
                                            <tr>
                                                <th class="ps-4">Número</th>
                                                <th>Fecha</th>
                                                <th>Estado</th>
                                                <th class="text-end">Monto Total</th>
                                                <th class="text-center pe-4">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="facturas" t-as="factura">
                                                <tr>
                                                    <td class="ps-4 fw-bold text-primary"><t t-esc="factura.name"/></td>
                                                    <td><t t-esc="factura.invoice_date"/></td>
                                                    <td>
                                                        <span t-attf-class="badge rounded-pill #{'bg-success' if factura.payment_state in ('in_payment', 'paid') else 'bg-warning text-dark'}">
                                                            <t t-esc="'Pagado' if factura.payment_state in ('in_payment', 'paid') else 'Pendiente'"/>
                                                        </span>
                                                    </td>
                                                    <td class="text-end fw-bold text-dark">$<t t-esc="'%.2f' % factura.amount_total"/></td>
                                                    <td class="text-center pe-4">
                                                        <a t-attf-href="/taller/factura/#{factura.id}/pdf" target="_blank" class="btn btn-sm btn-outline-danger rounded-pill">
                                                            <i class="fa fa-file-pdf-o me-1"/> PDF
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>

                    </div><!-- /tab-content -->
                </div><!-- /container -->
            </div><!-- /wrap -->
        </t>
    </template>
</odoo>
