<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_page" name="Login - Taller Mecánico">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty bg-light">
                <section class="py-5 taller-auth">
                    <div class="container py-5">
                        <div class="row justify-content-center">
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-lg taller-auth-card">
                                    <div class="card-body p-4 p-lg-5">
                                        <h2 class="fw-bold mb-2 taller-auth-title">Ingresar</h2>
                                        <p class="text-muted mb-4 taller-auth-subtitle">Accede con tu cuenta del sitio.</p>
                                        <t t-if="login_error">
                                            <div class="alert alert-danger" role="alert">
                                                Usuario, correo o contraseña incorrectos.
                                            </div>
                                        </t>
                                        <t t-if="unverified_error">
                                            <div class="alert alert-warning" role="alert">
                                                <t t-if="error_msg">
                                                    <t t-out="error_msg"/>
                                                </t>
                                                <t t-else="">
                                                    Su cuenta aún no ha sido verificada. Por favor, revise su correo electrónico para activarla.
                                                </t>
                                            </div>
                                        </t>
                                        <t t-if="verified_success">
                                            <div class="alert alert-success" role="alert">
                                                ¡Cuenta verificada con éxito! Ya puede iniciar sesión.
                                            </div>
                                        </t>
                                        <form action="/taller/login/submit" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Correo electrónico o Usuario (Cédula)</label>
                                                <input type="text" name="email" class="form-control form-control-lg" required="1" placeholder="ejemplo@email.com o 0102030405"/>
                                            </div>
                                            <div class="mb-4">
                                                <label class="form-label fw-bold">Password</label>
                                                <div class="input-group">
                                                    <input type="password" name="password" id="password_login" class="form-control form-control-lg" required="1" placeholder="********" style="border-right: none !important; border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important;"/>
                                                    <button class="btn btn-outline-secondary bg-white border-start-0 text-muted" type="button" onclick="togglePasswordVisibility('password_login', 'toggle_login_icon')" style="border-color: #dee2e6; border-left: none !important; border-top-right-radius: 8px !important; border-bottom-right-radius: 8px !important;">
                                                        <i class="fa fa-eye" id="toggle_login_icon"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <script>
                                                function togglePasswordVisibility(inputId, iconId) {
                                                    var passwordInput = document.getElementById(inputId);
                                                    var toggleIcon = document.getElementById(iconId);
                                                    if (passwordInput.type === 'password') {
                                                        passwordInput.type = 'text';
                                                        toggleIcon.classList.remove('fa-eye');
                                                        toggleIcon.classList.add('fa-eye-slash');
                                                    } else {
                                                        passwordInput.type = 'password';
                                                        toggleIcon.classList.remove('fa-eye-slash');
                                                        toggleIcon.classList.add('fa-eye');
                                                    }
                                                }
                                            </script>
                                            <button type="submit" class="btn btn-primary btn-lg w-100">Ingresar</button>
                                        </form>
                                        <div class="d-grid gap-2 mt-4">
                                            <a href="/taller/registro" class="btn btn-outline-primary btn-lg">Registrarse</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
