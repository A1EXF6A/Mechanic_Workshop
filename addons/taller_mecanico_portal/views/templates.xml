    <!-- Reemplazar el botón 'Iniciar sesión' con el nombre del usuario del taller cuando está logueado -->
    <!-- Reemplazar el botón 'Iniciar sesión' con el nombre del usuario del taller cuando está logueado -->
    <template id="taller_custom_sign_in" inherit_id="portal.placeholder_user_sign_in" name="Sign In Personalizado Taller">
        <xpath expr="." position="inside">
            <t t-set="taller_uid" t-value="request.session.get('taller_user_id')"/>
            <t t-set="taller_usr" t-value="request.env['usuarios_taller.user_profile'].sudo().browse(taller_uid).exists() if taller_uid else False"/>
            
            <t t-if="not taller_usr">
                <li t-nocache="Profile session and user group can change unrelated to parent caches." 
                    t-nocache-_item_class="_item_class" 
                    t-nocache-_link_class="_link_class" 
                    groups="base.group_public" 
                    t-attf-class="#{_item_class} o_no_autohide_item">
                    <a t-attf-href="/taller/login" t-attf-class="#{_link_class}">
                        Iniciar sesión
                    </a>
                </li>
            </t>
            <t t-if="taller_usr">
                <!-- Dropdown nativo de Bootstrap integrado en el Navbar de Odoo -->
                <li t-attf-class="#{_item_class} o_no_autohide_item dropdown taller-custom-dropdown">
                    <a href="#" role="button" data-bs-toggle="dropdown" t-attf-class="#{_link_class} dropdown-toggle d-flex align-items-center gap-2">
                        <span t-esc="taller_usr.nombre"/>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end shadow" role="menu">
                        <div class="dropdown-header">
                            <strong class="text-dark"><t t-esc="taller_usr.nombre"/> <t t-esc="taller_usr.apellido"/></strong><br/>
                            <small class="text-muted"><t t-esc="taller_usr.email"/></small>
                        </div>
                        <div class="dropdown-divider"/>
                        <a href="/taller/mi_cuenta" class="dropdown-item py-2"><i class="fa fa-user fa-fw me-1"/> Mi Cuenta</a>
                        <a href="/taller/cita" class="dropdown-item py-2"> Mis Citas</a>
                        <a href="/taller/consulta" class="dropdown-item py-2"> Trazabilidad</a>
                        <a href="/taller/carrito" class="dropdown-item py-2"> Mi Carrito</a>
                        <div class="dropdown-divider"/>
                        <a href="/taller/logout" class="dropdown-item py-2 text-danger"><i class="fa fa-sign-out fa-fw me-1"/> Cerrar Sesión</a>
                    </div>
                </li>
                <!-- Forzar ocultamiento del botón Iniciar Sesión por defecto y el dropdown nativo si no es admin -->
                <style>
                    header .o_no_autohide_item > a[href*='/web/login'] { display: none !important; }
                    <t t-if="not request.env.user.has_group('base.group_user')">
                    header li.o_no_autohide_item.dropdown:not(.taller-custom-dropdown) { display: none !important; }
                    </t>
                </style>
            </t>
        </xpath>
    </template>

    <!-- Estilos globales para visibilidad de menús de usuario -->
    <template id="taller_dropdown_visibility_fix" inherit_id="website.layout" name="Fix Dropdown Visibility">
        <xpath expr="//head" position="inside">
            <style>
                /* Nombre del usuario en el dropdown-header siempre visible */
                header .dropdown-menu .dropdown-header strong,
                header .dropdown-menu .dropdown-header {
                    color: #1e293b !important;
                }
                /* Iconos del menú siempre visibles con color oscuro */
                header .dropdown-menu .dropdown-item i,
                header .dropdown-menu .dropdown-item i.fa,
                header .dropdown-menu .dropdown-item .fa,
                header .dropdown-menu .dropdown-item svg {
                    color: #475569 !important;
                    fill: #475569 !important;
                    opacity: 1 !important;
                }
                /* Evitar duplicación de iconos: si hay un i.fa, ocultar los img nativos adyacentes */
                header .dropdown-menu .dropdown-item i.fa ~ img,
                header .dropdown-menu .dropdown-item i.fa ~ svg,
                header .dropdown-menu .dropdown-item img ~ i.fa {
                    display: none !important;
                }
                /* Items del dropdown legibles */
                header .dropdown-menu .dropdown-item {
                    color: #334155 !important;
                }
                /* Cerrar sesión en rojo */
                header .dropdown-menu .dropdown-item[href*="logout"] i,
                header .dropdown-menu .dropdown-item.text-danger,
                header .dropdown-menu .dropdown-item.text-danger i.fa,
                header .dropdown-menu a#o_logout,
                header .dropdown-menu a#o_logout i.fa,
                header .dropdown-menu a#o_logout svg {
                    color: #dc2626 !important;
                    fill: #dc2626 !important;
                }
            </style>
        </xpath>
    </template>

