    <!-- Inyectar Google Fonts y Script de Traducción al Vuelo -->
    <template id="taller_custom_head" inherit_id="website.layout" name="Head Personalizado Taller">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Poppins:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
            <!-- Script eliminado por causar conflictos con iconos nativos de Odoo -->
            <style type="text/css">
                /* Ocultar el enlace de inicio de sesión nativo de Odoo */
                header a[href*="/web/login"],
                header a[href="/web/login"],
                .o_no_autohide_item a[href*="/web/login"],
                .o_no_autohide_item a[href="/web/login"] {
                    display: none !important;
                }
            </style>
            <script type="text/javascript">
                /* Si el usuario del taller está logueado, ocultar el botón nativo de usuario de Odoo */
                (function() {
                    var isTallerUser = document.cookie.indexOf('session_id') !== -1;
                    /* Intentamos detectar la sesión del taller revisando el DOM una vez cargado */
                    document.addEventListener('DOMContentLoaded', function() {
                        var tallerDd = document.getElementById('tallerUserDd');
                        if (tallerDd) {
                            /* Hay dropdown del taller = ocultar el botón nativo de Odoo */
                            var style = document.createElement('style');
                            style.textContent = [
                                /* El botón del usuario nativo en el header de Odoo */
                                'header .o_no_autohide_item:has(img.o_avatar) { display: none !important; }',
                                /* Para navegadores que no soporten :has */
                                '.o_user_menu_mobile { display: none !important; }',
                                /* El icono de usuario genérico */
                                'header li.o_no_autohide_item > a > img { display: none !important; }',
                                /* Ocultar cualquier li que contenga un enlace a /web#action=logout */
                                'header .o_no_autohide_item a[data-action="logout"] { pointer-events: none !important; opacity: 0 !important; }',
                            ].join('\n');
                            document.head.appendChild(style);

                            /* Solución directa: ocultar el li padre del avatar nativo */
                            var allLiItems = document.querySelectorAll('header li.o_no_autohide_item');
                            allLiItems.forEach(function(li) {
                                var img = li.querySelector('img.o_avatar, img[src*="avatar"]');
                                var link = li.querySelector('a[href*="/web"]');
                                if (img || (link &amp;&amp; li.id !== 'tallerUserDd')) {
                                    li.style.setProperty('display', 'none', 'important');
                                }
                            });
                        }
                    });
                })();
            </script>
        </xpath>
    </template>



