        <field name="sequence" type="int">20</field>
    </record>

    <record id="menu_taller_nosotros" model="website.menu">
        <field name="name">Nosotros</field>
        <field name="url">/taller/nosotros</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">25</field>
    </record>

    <record id="menu_taller_contacto" model="website.menu">
        <field name="name">Contacto</field>
        <field name="url">/taller/contacto</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">30</field>
    </record>

    <record id="menu_taller_faq" model="website.menu">
        <field name="name">FAQ</field>
        <field name="url">/taller/faq</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">35</field>
    </record>

    <record id="menu_taller_cita" model="website.menu">
        <field name="name">Agendar Cita</field>
        <field name="url">/taller/cita</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">40</field>
    </record>

    <record id="menu_taller_consulta" model="website.menu">
        <field name="name">🔍 Trazabilidad</field>
        <field name="url">/taller/consulta</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">45</field>
    </record>

    <record id="menu_taller_productos" model="website.menu">
        <field name="name">Comprar Productos</field>
        <field name="url">/taller/productos</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">50</field>
    </record>

    <record id="menu_taller_carrito" model="website.menu">
        <field name="name">🛒 Carrito</field>
        <field name="url">/taller/carrito</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>

    <record id="menu_taller_login" model="website.menu">
        <field name="name">Ingresar</field>
        <field name="url">/taller/login</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">90</field>
    </record>

    <!-- Inyectar Google Fonts y Script de Traducción al Vuelo -->
    <template id="taller_custom_head" inherit_id="website.layout" name="Head Personalizado Taller">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Poppins:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                    function traducirInterfazTaller() {
                        // 1. Traducir placeholders de búsqueda
                        var searchInputs = document.querySelectorAll('input[type="search"], input[name="search"], .search-query');
                        searchInputs.forEach(function(input) {
                            input.placeholder = "Buscar servicios o repuestos...";
                        });

                        // 2. Traducir menús y enlaces en inglés del navbar
                        var navLinks = document.querySelectorAll('header#top .nav-link, header#top a, header .nav-link, header a');
                        navLinks.forEach(function(link) {
                            var txt = link.textContent.trim().toLowerCase();
                            if (txt === 'home') link.textContent = 'Inicio';
                            if (txt === 'shop') link.textContent = 'Tienda';
                            if (txt === 'services') link.textContent = 'Servicios';
                            if (txt === 'contact us') link.textContent = 'Contáctanos';
                            if (txt === 'my cart') link.textContent = 'Mi Carrito';
                        });
                        
                        // 3. Traducir botones de búsqueda nativos
                        var searchButtons = document.querySelectorAll('.oe_search_button, button[type="submit"]');
                        searchButtons.forEach(function(btn) {
                            if (btn.textContent.trim().toLowerCase() === 'search') {
                                btn.textContent = 'Buscar';
                            }
                        });
                    }

                    // Ejecutar de inmediato y con un pequeño delay para cubrir renderizados asíncronos de Odoo
                    traducirInterfazTaller();
                    setTimeout(traducirInterfazTaller, 500);
                    setTimeout(traducirInterfazTaller, 1500);
                });
            </script>
            <style type="text/css">
                /* Ocultar el enlace de inicio de sesión nativo de Odoo */
                header a[href*="/web/login"],
                header a[href="/web/login"],
                .o_no_autohide_item a[href*="/web/login"],
                .o_no_autohide_item a[href="/web/login"] {
                    display: none !important;
                }
            </style>
        </xpath>
    </template>


    <!-- Personalizar el Footer -->
    <template id="taller_custom_footer" inherit_id="website.layout" name="Footer Personalizado Taller">
        <xpath expr="//footer" position="replace">
            <footer id="footer" class="oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer" style="background-color: var(--taller-primary);">
                <section class="s_text_block pt64 pb48">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 mb-4 mt-3">
                                <h4 class="text-white mb-4">Autologic Center</h4>
                                <p class="text-white-50 lh-lg">Tu vehículo en las mejores manos. Ofrecemos calidad, confianza y garantía en todos nuestros servicios automotrices con tecnología de vanguardia.</p>
                                <div class="mt-4">
                                    <a href="#" class="btn btn-outline-light btn-sm rounded-circle me-2" style="width:36px; height:36px; padding: 6px;"><i class="fa fa-facebook"/></a>
                                    <a href="#" class="btn btn-outline-light btn-sm rounded-circle me-2" style="width:36px; height:36px; padding: 6px;"><i class="fa fa-instagram"/></a>
                                    <a href="#" class="btn btn-outline-light btn-sm rounded-circle" style="width:36px; height:36px; padding: 6px;"><i class="fa fa-twitter"/></a>
                                </div>
                            </div>
                            <div class="col-lg-4 mb-4 mt-3 ps-lg-5">
                                <h4 class="text-white mb-4">Enlaces Rápidos</h4>
                                <ul class="list-unstyled">
                                    <li class="mb-3"><a href="/" class="text-white-50 text-decoration-none">Inicio</a></li>
                                    <li class="mb-3"><a href="/taller/nosotros" class="text-white-50 text-decoration-none">Nosotros</a></li>
                                    <li class="mb-3"><a href="/taller/servicios" class="text-white-50 text-decoration-none">Servicios</a></li>
                                    <li class="mb-3"><a href="/taller/contacto" class="text-white-50 text-decoration-none">Contacto</a></li>
                                    <li class="mb-3"><a href="/taller/faq" class="text-white-50 text-decoration-none">Preguntas Frecuentes</a></li>
                                    <li class="mb-3"><a href="/taller/cita" class="text-white-50 text-decoration-none">Agendar Cita</a></li>
                                    <li class="mb-3"><a href="/taller/consulta" class="text-white-50 text-decoration-none">Trazabilidad de Orden</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-4 mb-4 mt-3">
                                <h4 class="text-white mb-4">Contacto</h4>
                                <ul class="list-unstyled text-white-50">
                                    <li class="mb-3 d-flex align-items-center"><i class="fa fa-map-marker me-3 text-primary"/> Av. de las Américas, Quito, Ecuador</li>
                                    <li class="mb-3 d-flex align-items-center"><i class="fa fa-phone me-3 text-primary"/> +593 99 999 9999</li>
                                    <li class="mb-3 d-flex align-items-center"><i class="fa fa-envelope me-3 text-primary"/> info@autologiccenter.com</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="o_footer_copyright py-4" style="background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.05);">
                    <div class="container">
                        <div class="row align-items-center text-white-50">
                            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                                <span>© 2026 Autologic Center. Todos los derechos reservados.</span>
                            </div>
                            <div class="col-md-6 text-center text-md-end">
                                <span class="small">Diseñado con <i class="fa fa-heart text-danger mx-1"/> para la excelencia automotriz.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>


    <!-- Reemplazar el botón 'Iniciar sesión' con el nombre del usuario del taller cuando está logueado -->
    <template id="taller_custom_sign_in" inherit_id="portal.placeholder_user_sign_in" name="Sign In Personalizado Taller">
        <xpath expr="." position="inside">
            <li t-nocache="Profile session and user group can change unrelated to parent caches." 
                t-nocache-_item_class="_item_class" 
                t-nocache-_link_class="_link_class" 
                groups="base.group_public" 
                t-attf-class="#{_item_class} o_no_autohide_item">
                <a t-attf-href="/taller/login" t-attf-class="#{_link_class}">
                    Iniciar sesión
                </a>
            </li>
        </xpath>
    </template>

    <!-- Inyectar bloque de usuario del taller en el header (después del sign_in nativo) -->
    <template id="taller_user_navbar" inherit_id="website.layout" name="Navbar Usuario Taller">
        <xpath expr="//header" position="inside">
            <t t-nocache="Taller user session changes independently.">
                <t t-set="taller_uid" t-value="request.session.get('taller_user_id')"/>
                <t t-if="taller_uid">
                    <t t-set="taller_usr" t-value="request.env['usuarios_taller.user_profile'].sudo().browse(taller_uid).exists()"/>
                    <t t-if="taller_usr">
                        <style>
                            /* Ocultar el botón nativo de Iniciar sesión cuando el usuario del taller está logueado */
                            .o_no_autohide_item a[href='/taller/login'] { display: none !important; }
                            /* Estilos del dropdown del usuario del taller */
                            .taller-user-dropdown {
                                position: fixed;
                                top: 8px;
                                right: 16px;
                                z-index: 1040;
                            }
                            .taller-user-btn {
                                background: rgba(59, 130, 246, 0.15);
                                border: 1px solid rgba(59, 130, 246, 0.3);
                                color: #fff;
                                padding: 6px 16px;
                                border-radius: 50px;
                                font-size: 14px;
                                font-weight: 500;
                                cursor: pointer;
                                display: flex;
                                align-items: center;
                                gap: 8px;
                                transition: all 0.2s;
                                text-decoration: none;
                            }
                            .taller-user-btn:hover {
                                background: rgba(59, 130, 246, 0.3);
                                color: #fff;
                                text-decoration: none;
                            }
                            .taller-user-btn i.fa-user-circle {
                                font-size: 18px;
                            }
                            .taller-user-menu {
                                display: none;
                                position: absolute;
                                top: 100%;
                                right: 0;
                                margin-top: 6px;
                                background: #fff;
                                border-radius: 10px;
                                box-shadow: 0 8px 30px rgba(0,0,0,0.15);
                                min-width: 200px;
                                overflow: hidden;
                                z-index: 1050;
                            }
                            .taller-user-menu.show { display: block; }
                            .taller-user-menu-header {
                                padding: 14px 16px;
                                background: #f8fafc;
                                border-bottom: 1px solid #e2e8f0;
                            }
                            .taller-user-menu-header strong {
                                display: block;
                                color: #1e293b;
                                font-size: 14px;
                            }
                            .taller-user-menu-header small {
                                color: #64748b;
                                font-size: 12px;
                            }
                            .taller-user-menu a {
                                display: flex;
                                align-items: center;
                                gap: 10px;
                                padding: 10px 16px;
                                color: #334155;
                                text-decoration: none;
                                font-size: 14px;
                                transition: background 0.15s;
                            }
                            .taller-user-menu a:hover {
                                background: #f1f5f9;
                            }
                            .taller-user-menu a i {
                                width: 18px;
                                text-align: center;
                                color: #3b82f6;
                            }
                            .taller-user-menu a.logout-link {
                                border-top: 1px solid #e2e8f0;
                                color: #ef4444;
                            }
                            .taller-user-menu a.logout-link i { color: #ef4444; }
                        </style>
                        <div class="taller-user-dropdown" id="tallerUserDropdown">
                            <a href="#" class="taller-user-btn" id="tallerUserBtn" onclick="event.preventDefault(); document.getElementById('tallerUserMenu').classList.toggle('show');">
                                <i class="fa fa-user-circle"/>
                                <span t-esc="taller_usr.nombre"/>
                            </a>
                            <div class="taller-user-menu" id="tallerUserMenu">
                                <div class="taller-user-menu-header">
                                    <strong><t t-esc="taller_usr.nombre"/> <t t-esc="taller_usr.apellido"/></strong>
                                    <small t-esc="taller_usr.email"/>
                                </div>
                                <a href="/taller/mi_cuenta"><i class="fa fa-user-circle-o"/>Mi Cuenta</a>
                                <a href="/taller/cita"><i class="fa fa-calendar"/>Mis Citas</a>
                                <a href="/taller/consulta"><i class="fa fa-search"/>Trazabilidad</a>
                                <a href="/taller/carrito"><i class="fa fa-shopping-cart"/>Mi Carrito</a>
                                <a href="/taller/logout" class="logout-link"><i class="fa fa-sign-out"/>Cerrar Sesión</a>
                            </div>
                        </div>
                        <script>
                            // Cerrar el menú al hacer clic fuera
                            document.addEventListener('click', function(e) {
                                var dropdown = document.getElementById('tallerUserDropdown');
                                var menu = document.getElementById('tallerUserMenu');
                                if (dropdown &amp;&amp; menu &amp;&amp; !dropdown.contains(e.target)) {
                                    menu.classList.remove('show');
                                }
                            });
                        </script>
                    </t>
                </t>
            </t>
        </xpath>
    </template>

    <!-- Redirigir el carrito de compra estándar al carrito del taller -->
    <template id="taller_custom_cart_link" inherit_id="website_sale.header_cart_link" name="Cart Personalizado Taller">
        <xpath expr="//a" position="attributes">
            <attribute name="href">/taller/carrito</attribute>
            <attribute name="t-attf-href">/taller/carrito</attribute>
        </xpath>
    </template>
</odoo>
